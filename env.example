# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration (SQLite)
DATABASE_PATH=./data/bookvid.db
DB_TIMEOUT=10000
DB_CACHE_SIZE=-64000
DB_MMAP_SIZE=268435456
DB_JOURNAL_MODE=WAL
DB_SYNCHRONOUS=NORMAL
DB_TEMP_STORE=MEMORY

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Personal AI API Keys
OPENAI_API_KEY=your_openai_api_key
RESEMBLE_API_KEY=your_resemble_api_token
RESEMBLE_PROJECT_ID=your_resemble_project_uuid
RESEMBLE_VOICE_ID=your_default_voice_uuid
STABILITY_API_KEY=your_stability_ai_key

# Shotstack Video Rendering API
SHOTSTACK_API_KEY=your_shotstack_api_key
SHOTSTACK_HOST=https://api.shotstack.io/stage
SHOTSTACK_ENV=stage

# Book Search API Keys
GOOGLE_BOOKS_API_KEY=your_google_books_api_key

# Application Configuration
NODE_ENV=development
PORT=3000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:3000

# File Storage Configuration
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=50000000

# Cache Configuration
CACHE_MAX_SIZE=1000
CACHE_DEFAULT_TTL=3600
CACHE_CLEANUP_INTERVAL=300

# Session Configuration
SESSION_TTL=86400
